{
  "name": "@occluze/tether",
  "version": "0.7.2",
  "description": "Free, open-source alternative to Smootify and Storesynk (Shopyflow): Shopify products, cart and subscriptions in Webflow with HTML attributes. Optional Shopify to Webflow CMS sync.",
  "type": "module",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./server": {
      "types": "./dist/types/src/server.d.ts",
      "default": "./dist/esm/server.js"
    },
    "./astro": {
      "types": "./dist/types/src/astro.d.ts",
      "default": "./dist/esm/astro.js"
    },
    "./presets/barba": {
      "types": "./dist/types/src/presets/barba.d.ts",
      "default": "./dist/presets/barba.esm.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.ts",
    "dev": "node --experimental-strip-types scripts/build.ts --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "deps": "depcruise --config .config/dependency-cruiser.cjs src server/src server/bin server/scripts scripts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run knip && npm run deps && npm test",
    "prepare": "lefthook install",
    "test": "node --experimental-strip-types --test test/*.test.js server/test/*.test.js && npm run test:types",
    "test:types": "tsc -p test/types/tsconfig.json",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "pretest": "node --experimental-strip-types scripts/build.ts --out .test-dist",
    "presmoke": "node --experimental-strip-types scripts/build.ts",
    "release": "node --experimental-strip-types scripts/release.ts",
    "e2e:build": "npm run build && cd examples/astro && (test -f .env || cp .env.example .env) && npm install --no-save --no-audit --no-fund --ignore-scripts ../.. && npx astro build",
    "e2e": "npm run e2e:build && playwright test -c test/e2e/playwright.config.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/jsdom": "21.1.7",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.2",
    "esbuild": "0.25.12",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jsdom": "26.1.0",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "author": {
    "name": "Ravi Klaassens",
    "url": "https://occluze.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravi-klaassens/tether.git"
  },
  "homepage": "https://github.com/ravi-klaassens/tether#readme",
  "bugs": {
    "url": "https://github.com/ravi-klaassens/tether/issues"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "cart",
    "ecommerce",
    "headless",
    "headless-commerce",
    "headless-shopify",
    "selling-plans",
    "shopify",
    "shopify-subscriptions",
    "shopyflow-alternative",
    "smootify-alternative",
    "ssr",
    "storefront-api",
    "storesynk-alternative",
    "subscriptions",
    "webflow",
    "webflow-cms",
    "webflow-ecommerce",
    "webflow-shopify",
    "withastro"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/types/src/index.d.ts",
  "peerDependencies": {
    "astro": ">=4"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "overrides": [
      {
        "files": "*.md",
        "options": {
          "embeddedLanguageFormatting": "off"
        }
      },
      {
        "files": "CHANGELOG.md",
        "options": {
          "proseWrap": "always",
          "printWidth": 100
        }
      }
    ]
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "src/server.ts",
      "src/astro.ts",
      "src/presets/barba.ts",
      "src/parts/*.ts",
      "src/lazy-iife.ts",
      "server/src/entry.{js,ts}",
      "server/src/index.ts",
      "server/bin/tether-sync.{js,ts}",
      "server/scripts/*.{mjs,ts}",
      "scripts/*.ts",
      "test/**/*.js",
      "server/test/**/*.js",
      "test/e2e/*.{js,mjs}",
      "test/types/check.ts"
    ],
    "project": [
      "src/**/*.ts",
      "server/src/**/*.{js,ts}",
      "server/bin/*.{js,ts}",
      "server/scripts/*.{mjs,ts}",
      "scripts/*.ts"
    ],
    "ignoreBinaries": [
      "tsc"
    ]
  },
  "overrides": {
    "minimatch": "11.0.5"
  }
}
